# ─────────────────────────────────────────────────────────────────────
# SECRETS — nothing matching these may ever be committed.
# Patterns, not filenames, so a file added later is covered by default.
# Verify with: npm run check:secrets
# ─────────────────────────────────────────────────────────────────────
.credentials*
*.local
*.local.*
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
!.dev.vars.example
!**/.dev.vars.example
.env
.env.*
!.env.example
!*.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.credentials.json
service-account*.json

# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# cloudflare / wrangler local state
.wrangler/

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*

# local scratch
_archive/
coverage/
